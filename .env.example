# Copier vers .env (non versionné) pour changer les valeurs par défaut.
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5433
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag

# Phase 3 (génération) : clé personnelle à mettre dans .env, jamais ici ni dans le code.
ANTHROPIC_API_KEY=

# Phase 5 (traçage, optionnel — l'API répond sans, juste sans trace_url) : cloud.langfuse.com, projet
# gratuit, Settings > API Keys. LANGFUSE_HOST par défaut = https://cloud.langfuse.com.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Phase 5 : port local de l'API (docker-compose)
API_PORT=8000
